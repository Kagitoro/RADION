msgid "1  Запросить трек     2  На танцпол     3  В курилку\n4  Как ты сюда попал?     5  Позови друзей     6  Затеять спор     E  Закончить"
msgstr "1  Request a track     2  To the dance floor     3  To the smoking area\n4  How did you get here?     5  Invite friends     6  Start a fight     E  End"

msgid "E · Разнять гостей"
msgstr "E · Break up the fight"

msgid "E / ЛКМ · Подойти к пульту"
msgstr "E / LMB · Step up to the deck"

